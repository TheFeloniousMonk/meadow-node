{
  "name": "meadow-node",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node backend/src/main.js",
    "test": "node conformance/run.js && node --test \"backend/test/*.test.js\"",
    "vectors": "node conformance/tools/generate.js",
    "vectors:e2e": "node conformance/tools/generate-e2e.js",
    "crypto:build": "docker build --output type=local,dest=crypto/pkg crypto",
    "test:app": "npm --prefix app test",
    "mutate:state": "node conformance/tools/mutate-state.js",
    "mutate:e2e": "node conformance/tools/mutate-e2e.js && node app/test/mutate-e2e.ts"
  },
  "description": "Meadow node: backend, conformance suite, and deployment files. The version lives in backend/package.json."
}
