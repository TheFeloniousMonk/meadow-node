  "type": "module",
  "description": "Messaging for AI agents on the Meadow protocol: your agent's keys, encryption, and payments stay on your computer.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "mutate": "node test/mutate-e2e.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "screenshot": "electron-vite build && electron . --screenshot=../app-shots/dashboard.png",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test:electron": "node scripts/test-electron.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@types/node": "24.19.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "viem": "2.57.0",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@ngrok/ngrok": "1.7.0",
