{
  "format": "meadow-plugin/1",
  "id": "media",
  "name": "Rich Media Embeds",
  "version": "1.2.0",
  "description": "Videos, music, images, files, and maths in messages: YouTube videos, SoundCloud tracks, images on Imgur, Google Drive, or Dropbox, Google Drive files such as videos and PDFs, and LaTeX formulas. Nothing loads until you press Play or Show.",
  "author": "Meadow",
  "hosts": [
    "www.youtube-nocookie.com",
    "w.soundcloud.com",
    "i.imgur.com",
    "lh3.googleusercontent.com",
    "drive.google.com",
    "dl.dropboxusercontent.com"
  ],
  "types": {
    "video": {
      "description": "A YouTube video, by its 11-character ID (the part after watch?v= or youtu.be/).",
      "example": {
        "id": "M7lc1UVf-VE",
        "title": "A video"
      },
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 11,
            "pattern": "[A-Za-z0-9_-]{11}",
            "description": "The video ID."
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "pattern": ".{1,200}",
            "description": "A title to show (optional)."
          }
        },
        "required": [
          "id"
        ]
      },
      "render": {
        "component": "video",
        "src": "https://www.youtube-nocookie.com/embed/{id}",
        "title": "{title}"
      },
      "fallback": "Video: https://youtu.be/{id}"
    },
    "track": {
      "description": "A SoundCloud track, by its artist and track names as they appear in its address (soundcloud.com/artist/track).",
      "example": {
        "artist": "an-artist",
        "track": "a-track"
      },
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artist": {
            "type": "string",
            "maxLength": 100,
            "pattern": "[a-z0-9_-]{1,100}"
          },
          "track": {
            "type": "string",
            "maxLength": 200,
            "pattern": "[a-z0-9_-]{1,200}"
          }
        },
        "required": [
          "artist",
          "track"
        ]
      },
      "render": {
        "component": "audio",
        "kind": "player",
        "src": "https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/{artist}/{track}",
        "title": "{artist}: {track}"
      },
      "fallback": "Listen: https://soundcloud.com/{artist}/{track}"
    },
    "image": {
      "description": "An image on Imgur, by its ID and file type (i.imgur.com/ID.png).",
      "example": {
        "id": "abc1234",
        "ext": "png",
        "alt": "A picture"
      },
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 10,
            "pattern": "[A-Za-z0-9]{5,10}"
          },
          "ext": {
            "type": "string",
            "maxLength": 4,
            "enum": [
              "png",
              "jpg",
              "jpeg",
              "gif",
              "webp"
            ]
          },
          "alt": {
            "type": "string",
            "maxLength": 300,
            "pattern": ".{1,300}",
            "description": "What the image shows, in words."
          }
        },
        "required": [
          "id",
          "ext",
          "alt"
        ]
      },
      "render": {
        "component": "image",
        "src": "https://i.imgur.com/{id}.{ext}",
        "alt": "{alt}"
      },
      "fallback": "Image ({alt}): https://i.imgur.com/{id}.{ext}"
    },
    "drive-image": {
      "description": "An image in Google Drive shared as \"Anyone with the link can view\", by its file ID (the part after /d/ in the link). Shown up to 1,600 pixels wide.",
      "example": {
        "id": "13XE4Ah1aK5kSGniMbeard9DJ1iuroR_K",
        "alt": "A picture"
      },
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "[A-Za-z0-9_-]{20,100}",
            "description": "The file ID."
          },
          "alt": {
            "type": "string",
            "maxLength": 300,
            "pattern": ".{1,300}",
            "description": "What the image shows, in words."
          }
        },
        "required": [
          "id",
          "alt"
        ]
      },
      "render": {
        "component": "image",
        "src": "https://lh3.googleusercontent.com/d/{id}=w1600",
        "alt": "{alt}"
      },
      "fallback": "Image ({alt}): https://drive.google.com/file/d/{id}/view"
    },
    "drive-file": {
      "description": "A file in Google Drive shared as \"Anyone with the link can view\", shown in Drive's own viewer: videos play, PDFs and documents can be read. By its file ID (the part after /d/ in the link).",
      "example": {
        "id": "13XE4Ah1aK5kSGniMbeard9DJ1iuroR_K",
        "title": "A file"
      },
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "pattern": "[A-Za-z0-9_-]{20,100}",
            "description": "The file ID."
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "pattern": ".{1,200}",
            "description": "A title to show (optional)."
          }
        },
        "required": [
          "id"
        ]
      },
      "render": {
        "component": "video",
        "src": "https://drive.google.com/file/d/{id}/preview",
        "title": "{title}"
      },
      "fallback": "File: https://drive.google.com/file/d/{id}/view"
    },
    "dropbox-image": {
      "description": "An image in Dropbox shared as \"Anyone with the link can view\", from its link (dropbox.com/scl/fi/ID/NAME?rlkey=KEY): give ID, NAME, and KEY. The key opens the file to anyone who has it, so share only images meant to be seen.",
      "example": {
        "id": "abc123def456ghi789jkl",
        "name": "photo.jpg",
        "rlkey": "abcdefghijklmnopqrstuvwxy",
        "alt": "A picture"
      },
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "[a-z0-9]{10,64}",
            "description": "The part after /scl/fi/."
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "pattern": "[A-Za-z0-9._() -]{1,200}",
            "description": "The file name, as in the link."
          },
          "rlkey": {
            "type": "string",
            "maxLength": 64,
            "pattern": "[a-z0-9]{10,64}",
            "description": "The rlkey value from the link."
          },
          "alt": {
            "type": "string",
            "maxLength": 300,
            "pattern": ".{1,300}",
            "description": "What the image shows, in words."
          }
        },
        "required": [
          "id",
          "name",
          "rlkey",
          "alt"
        ]
      },
      "render": {
        "component": "image",
        "src": "https://dl.dropboxusercontent.com/scl/fi/{id}/{name}?rlkey={rlkey}",
        "alt": "{alt}"
      },
      "fallback": "Image ({alt}): https://www.dropbox.com/scl/fi/{id}/{name}?rlkey={rlkey}&dl=0"
    },
    "formula": {
      "description": "A maths formula in LaTeX, shown on its own line. Rendered on this computer; nothing loads.",
      "example": {
        "tex": "e^{i\\pi} + 1 = 0"
      },
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tex": {
            "type": "string",
            "maxLength": 1000,
            "pattern": ".{1,1000}",
            "description": "The LaTeX source, on one line."
          }
        },
        "required": [
          "tex"
        ]
      },
      "render": {
        "component": "math",
        "tex": "{tex}",
        "display": true
      },
      "fallback": "Formula: {tex}"
    }
  }
}
